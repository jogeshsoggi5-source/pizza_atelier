################################################################################
# Pizza Atelier - Environment Configuration
# Copy this file to .env and fill in your actual values
#
# IMPORTANT SECURITY NOTES:
# - .env file should NEVER be committed to Git
# - For production, set these in your Vercel dashboard: Settings → Environment Variables
# - Keep actual API keys private and secure
# - Never share your service role key publicly
################################################################################

# ============================================
# APPLICATION ENVIRONMENT
# ============================================
# Do NOT set NODE_ENV here — Vite sets it automatically (development for `npm run dev`,
# production for `npm run build`). Setting it here makes production builds use React's
# dev JSX runtime and every page crashes with "jsxDEV is not a function".

# ============================================
# SUPABASE CONFIGURATION
# ============================================
# Get these values from: https://app.supabase.com → Your Project → Settings → API

# Public/Client-side Supabase variables (SAFE to expose in code)
# These are used by the frontend and can be public
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Server-side Supabase variables (SENSITIVE - Keep private!)
# Only use on backend/server functions, never expose in frontend
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================
# ORDER CONFIRMATION SMS (server-side only — never prefix with VITE_)
# ============================================
# Set ONE provider. See src/lib/order-sms.ts.
# FAST2SMS_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+15551234567
# SMS_PROVIDER=fast2sms
# SMS_COUNTRY_CODE=91
# SITE_URL=https://your-domain.com

# ============================================
# APPLICATION SETTINGS
# ============================================

# Delivery settings
VITE_DELIVERY_FEE=3

# Restaurant info (optional)
VITE_RESTAURANT_NAME=Pizza Atelier
VITE_RESTAURANT_ADDRESS=214 Artisan Lane, Brooklyn, NY 11201
VITE_RESTAURANT_PHONE=+1 (555) 012-3456
VITE_RESTAURANT_EMAIL=hello@pizzaatelier.com
